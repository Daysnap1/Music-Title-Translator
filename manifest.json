{
  "manifest_version": 3,
  "name": "YT Music Title Translator",
  "version": "1.1",
  "description": "Auto-translates non-English song titles, artists and albums on YouTube Music.",
  "permissions": ["storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
